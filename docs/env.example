# ── Telegram Mini-App ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=               # raw bot token for HMAC validation                     # secret
TELEGRAM_BOT_ID=                  # numeric bot ID needed for validate3rd() fallback      # public
TELEGRAM_BOT_USERNAME=            # @username used in deep-links                          # public
TELEGRAM_APP_SHORT_NAME=          # mini-app short_name in startapp links                 # public
INIT_DATA_MAX_AGE=3600            # seconds a signature is accepted (library option)      # public

# ── Supabase core ─────────────────────────────────────────────────────────────
SUPABASE_URL=                                 # project REST root URL                     # public
SUPABASE_ANON_KEY=                            # public anon key for client SDK            # secret*
SUPABASE_SERVICE_ROLE_KEY=                    # service-role key for Edge / cron workers  # secret
SUPABASE_JWT_SECRET=                          # if overriding the default JWT secret      # secret
SUPABASE_PROJECT_REF=                         # 7-char project ref (CLI)                  # public
SUPABASE_DB_PASSWORD=                         # direct Postgres password (optional)       # secret

# ── Observability / 3rd-party ────────────────────────────────────────────────
AD_SDK_KEY=                       # rewarded-ads provider key                             # secret

# Legend
# secret – real value never committed; set via Vercel / Supabase dashboards or secret-manager.
# public – safe to commit (and may be prefixed PUBLIC_ for Next.js).
# * Although SUPABASE_ANON_KEY is technically public, treat it like a credential to avoid abuse.


