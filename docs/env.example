# Server (Next.js API)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tap_app_local
TELEGRAM_BOT_TOKEN=
INITDATA_TTL_SECONDS=3600

# Client (Next.js Public)
NEXT_PUBLIC_LEADERBOARD_ACTIVE_WINDOW_DAYS=1

# Common Dev & Testing
# Note: For local dev, DEV_TOKEN and NEXT_PUBLIC_DEV_TOKEN should be identical.
# The `npm run setup:env` script in `web/` handles this automatically.
DEV_TOKEN=nusuev_loacal_token_122149
NEXT_PUBLIC_DEV_TOKEN=nusuev_loacal_token_122149
# Allow running the app outside Telegram for dev purposes (requires `?dev=1` in URL)
NEXT_PUBLIC_ENABLE_OUTSIDE_TG_DEV=0
# Allow creating dev users via API without a real Telegram user ID
ENABLE_RANDOM_DEV_USER=0
